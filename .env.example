# ULTRON 2.0 - Configuração de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# O .env é carregado automaticamente por main.py / `python -m ultron_2_0`
# (bootstrap.load_env) e NUNCA deve ser versionado.

# ============================================================================
# Provedor de Modelo LLM
# ============================================================================

# Provedor padrão: nvidia (NVIDIA NIM)
# Defina a chave de API da NVIDIA para usar o provedor real
# Sem essa chave, o sistema usará o provedor mock (simulado)
NVIDIA_API_KEY=coloque_sua_chave_nvidia_aqui

# Modelo padrão da NVIDIA NIM
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-flash

# Provedor Gemini (alternativa)
# GEMINI_API_KEY=sua_chave_gemini_aqui
# GEMINI_DEFAULT_MODEL=gemini-3.5-flash

# ============================================================================
# Configuração do Model Router
# ============================================================================

# Modo de roteamento: "primary" (provedor padrão) ou "auto" (seleção por tarefa)
ULTRON_ROUTER_MODE=primary

# Fallback entre provedores (opt-in)
ULTRON_ROUTER_FALLBACK=false

# Timeout por chamada (segundos)
ULTRON_ROUTER_TIMEOUT=45.0

# Número máximo de tentativas por provedor
ULTRON_ROUTER_MAX_ATTEMPTS=2

# Backoff exponencial base (segundos)
ULTRON_ROUTER_BACKOFF=0.25

# Backoff máximo (segundos)
ULTRON_ROUTER_MAX_BACKOFF=4.0

# Cooldown após falha (segundos)
ULTRON_ROUTER_COOLDOWN=30.0

# Permitir mock como fallback (NUNCA em produção)
ULTRON_ROUTER_ALLOW_MOCK_FALLBACK=false

# Provedores permitidos (vazio = todos)
# ULTRON_ROUTER_PROVIDERS=nvidia,gemini

# Overrides de modelo por tarefa (JSON)
# ULTRON_ROUTER_MODELS={"nvidia": {"code": "nvidia/nemotron-3.5-code"}}
