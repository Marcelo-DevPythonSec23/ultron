# ULTRON 2.0 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite credenciais reais no repositório.

# =============================================================================
# Provedor de Modelo LLM (Fase 7 — INTERFACE.md §3)
# =============================================================================

# Provedor principal: NVIDIA NIM (compatível com OpenAI)
# Obtenha sua chave em: https://build.nvidia.com/
NVIDIA_API_KEY=sua_chave_nvidia_aqui

# Modelo padrão do NVIDIA NIM (configurável conforme modelos disponíveis)
# Exemplos: nvidia/nemotron-3.5-flash, nvidia/nemotron-3.5-15b, etc.
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-flash

# URL base da API NVIDIA NIM (não altere exceto em ambientes de teste)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# =============================================================================
# Provedor Gemini (alternativa, mantido para compatibilidade)
# =============================================================================

# GEMINI_API_KEY=sua_chave_gemini_aqui
# GEMINI_DEFAULT_MODEL=gemini-3.5-flash

# =============================================================================
# Configuração do Model Router (Fase 3)
# =============================================================================

# Modo do roteador: "primary" (provedor padrão) ou "auto" (seleção por tarefa)
ULTRON_ROUTER_MODE=primary

# Fallback entre provedores (opt-in — não recomenda-se para produção)
ULTRON_ROUTER_FALLBACK=false

# Timeout por chamada (segundos)
ULTRON_ROUTER_TIMEOUT=45.0

# Tentativas por candidato
ULTRON_ROUTER_MAX_ATTEMPTS=2

# Backoff exponencial base (segundos)
ULTRON_ROUTER_BACKOFF=0.25

# Backoff máximo (segundos)
ULTRON_ROUTER_MAX_BACKOFF=4.0

# Cooldown após falha (segundos)
ULTRON_ROUTER_COOLDOWN=30.0

# Permitir mock como fallback automático (NUNCA em produção)
ULTRON_ROUTER_ALLOW_MOCK_FALLBACK=false

# Provedores permitidos (vazio = todos registrados)
# ULTRON_ROUTER_PROVIDERS=nvidia

# Overrides de modelo por tarefa (JSON)
# ULTRON_ROUTER_MODELS={"nvidia": {"code": "nvidia/nemotron-3.5-code"}}

# =============================================================================
# Banco de Dados
# =============================================================================

# URL do banco SQLite do ULTRON 2.0 (isolado do lain/ultron.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/ultron2.db

# =============================================================================
# Memória (Fase 6)
# =============================================================================

# Caminho do arquivo de memória (padrão: data/memory.json)
# MEMORY_PATH=./data/memory.json

# Orçamento de caracteres para injeção de memória (padrão: 1200)
# MEMORY_BUDGET_CHARS=1200
